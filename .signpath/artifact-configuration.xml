<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for Cetone's Windows release.

  SignPath does not read this file from the repository: paste it into
  SignPath → Projects → cetone → Artifact configurations (slug "initial",
  or whatever SIGNPATH_ARTIFACT_CONFIGURATION_SLUG names). It is kept here so
  the configuration is reviewed and versioned with the workflow that uses it.

  The GitHub artifact uploaded by .github/workflows/release.yml is always a zip
  ("windows-unsigned") holding exactly two programs:
    cetone-windows-amd64.exe
    cetone-windows-arm64.exe
  Both are Authenticode-signed (SHA-256, timestamped by SignPath), and
  SignPath returns the same zip with the signed files.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="cetone-windows-amd64.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="cetone-windows-arm64.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
